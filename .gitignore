/android/app/release

# Widget Preview related
.widget_preview/

# Secrets / environment files
.env
.env.*
**/.env

# Local databases generated at runtime (Drift/SQLite)
*.sqlite
*.sqlite3
*.db

# Generated code (Drift / build_runner).
# Drift recomienda SUBIR estos archivos al repositorio para que quien clone
# el proyecto no necesite correr build_runner. Si prefieres ignorarlos,
# descomenta la siguiente línea:
# *.g.dart
